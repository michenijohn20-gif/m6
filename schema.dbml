Table users {
  id integer [primary key]
  email varchar
  password_hash varchar
  created_at timestamp
}

Table search_history {
  id integer [primary key]
  user_id integer
  search_query varchar
  searched_at timestamp
}

Table reviews {
  id integer [primary key]
  product_query varchar
  shop varchar
  author varchar
  comment text
  rating float
  created_at timestamp
}

Ref: search_history.user_id > users.id
