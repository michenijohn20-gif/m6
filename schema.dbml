// BlueCart Marketplace — persisted schema
// Only registered-user data lives here. Product listings from Amazon/eBay/
// Shopify/Alibaba are fetched live per search and never written to the DB
// (see backend/services/crawler.py + backend/routes/search.py).

Table users {
  id integer [primary key, increment]
  email varchar(120) [not null, unique]
  password_hash varchar(255) [not null]
  created_at timestamp [default: `now()`]

  Note: 'A registered account. Password is bcrypt-hashed, never stored raw.'
}

Table search_history {
  id integer [primary key, increment]
  user_id integer [not null]
  search_query varchar(255) [not null]
  searched_at timestamp [default: `now()`]

  Note: 'One row per search a logged-in user runs. Guests (no JWT) are not logged.'
}

Ref: search_history.user_id > users.id
