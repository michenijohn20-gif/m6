DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bluecart
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
FLASK_ENV=development

# RapidAPI key, shared across all subscribed listings by default. If
# Amazon/AliExpress are subscribed under different RapidAPI accounts,
# set RAPIDAPI_AMAZON_KEY / RAPIDAPI_ALIEXPRESS_KEY to override per site.
RAPIDAPI_KEY=
RAPIDAPI_AMAZON_KEY=
RAPIDAPI_ALIEXPRESS_KEY=
RAPIDAPI_AMAZON_HOST=real-time-amazon-data.p.rapidapi.com
RAPIDAPI_ALIEXPRESS_HOST=aliexpress-datahub.p.rapidapi.com

# eBay Browse API (OAuth2 client-credentials) — requires an approved
# eBay developer account. Leave blank to skip eBay results.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# No live FX API configured — fixed approximate USD->KES rate.
USD_TO_KES_RATE=130
